<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="2"
    android:versionName="0.4.0">


    <!-- Pleos Vehicle SDK: 주행거리(Odometer), 연료·배터리(Fuel/EvBattery), 차량정보(CarInfo), 브레이크 -->
    <uses-permission android:name="pleos.car.permission.CAR_MILEAGE" />
    <!-- Pleos Connect 2.1.0 에뮬레이터는 주행거리를 CAR_DRIVE 로 묶는다 (CAR_MILEAGE 미정의) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_POWERTRAIN" />
    <!-- 광고 모드의 차속 읽기(PERF_VEHICLE_SPEED). 에뮬레이터에서 protectionLevel="dangerous" 로 확인했다 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- 운전석 시트 위치로 시동 직후 운전자를 판별 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- Pleos FusedLocation / STT / TTS SDK -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- 일일 앵커의 RFC 3161 타임스탬프 요청 (날짜와 해시의 지문만 보낸다) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Popolog"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name="ai.chagok.app.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo(음성 비서)가 부르는 함수. assets/schema.json 의 actionCalls 와 이름이 같다 -->
            <intent-filter>
                <action android:name="ADD_EXPENSE" />
                <action android:name="ai.chagok.app.action.ADD_EXPENSE" />
                <action android:name="QUERY_REPORT" />
                <action android:name="ai.chagok.app.action.QUERY_REPORT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
